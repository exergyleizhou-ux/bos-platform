# BOS Pipeline v9.0 frontend environment

# API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional app chrome
VITE_APP_TITLE=BOS Pipeline

# Feature flags
VITE_ENABLE_DIGITAL_TWINS=true
VITE_ENABLE_SUSTAINABILITY=true
VITE_ENABLE_FORECAST=true
VITE_ENABLE_BOS_SIMULATION_LAB=false

# Login immersive renderer mode
# auto        -> prefer real gaussian backend when a manifest is available, else fallback
# procedural  -> force procedural fallback scenes
# gaussian    -> require real gaussian backend, throw if unavailable
VITE_SCENE_RENDERER_MODE=auto

# Real gaussian scene manifest
# Option A: inline JSON array of scene assets
# Option B: URL/path to a JSON file, for example /splats/manifest.json
VITE_GAUSSIAN_SCENE_MANIFEST=/splats/manifest.json

# Optional CDN override for @mkkellogg/gaussian-splats-3d
# VITE_GAUSSIAN_SPLATS_CDN=https://cdn.jsdelivr.net/npm/@mkkellogg/gaussian-splats-3d/build/gaussian-splats-3d.umd.cjs
