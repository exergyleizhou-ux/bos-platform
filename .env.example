# BOS Pipeline v9.0 environment template
#
# Copy this file to .env and adjust only the values you need.
# The defaults below are local-first so the repository boots cleanly
# on a developer workstation before you move to Docker or shared infra.

# Application
APP_NAME=BOS Pipeline
APP_VERSION=9.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Local-first defaults use SQLite. Docker and production can override these.
DATABASE_URL=sqlite+aiosqlite:///./bos.db
DATABASE_URL_SYNC=sqlite:///./bos.db
POSTGRES_USER=bos
POSTGRES_PASSWORD=bos_secret
POSTGRES_DB=bos_pipeline

# Redis / Celery
# Redis is optional for local backend-only work, but keep the values ready.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Authentication
JWT_SECRET_KEY=change-me-jwt-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BOS Pipeline <noreply@bos-pipeline.com>

# Error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_SENTRY_DSN=
VITE_APP_VERSION=9.0.0

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=bos-pipeline-backend
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
OTEL_CONSOLE_EXPORT=false
OTEL_ENVIRONMENT=development

# Feature flags
FF_ENABLE_MONTE_CARLO=true
FF_ENABLE_DIGITAL_TWIN=true
FF_ENABLE_AUTOML=false
FF_ENABLE_WEBSOCKET=true
FF_ENABLE_EXPORT_PARQUET=true
FF_ENABLE_BILLING=true
FF_ENABLE_MULTI_LANGUAGE=true
FF_ENABLE_DARK_MODE=true
FF_ENABLE_BOS_CODE=false
FF_ENABLE_BOS_SIMULATION_LAB=false

# BOS Code runtime
BOS_CODE_WORKTREE_ROOT=.bos-code-worktrees
BOS_CODE_GIT_EXECUTABLE=
BOS_CODE_DEFAULT_PROVIDER=openai-team
BOS_CODE_DEFAULT_MODEL=gpt-5.5
BOS_CODE_MAX_SESSION_TOKENS=64000
BOS_CODE_MAX_FILE_READ_BYTES=262144
BOS_CODE_MAX_FILE_WRITE_BYTES=131072
BOS_CODE_SAFE_BASH_TIMEOUT_SEC=30
BOS_CODE_LEASE_TTL_SEC=300
BOS_CODE_HEARTBEAT_INTERVAL_SEC=30
BOS_CODE_EVENT_REPLAY_LIMIT=500
BOS_CODE_SUBAGENT_ASYNC_DISPATCH=false

# OpenAI / BOS Code provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_PUBLIC_API_KEY=
OPENAI_PUBLIC_BASE_URL=
OPENAI_PUBLIC_ORGANIZATION=
OPENAI_PUBLIC_PROJECT=
OPENAI_TEAM_API_KEY=
OPENAI_TEAM_BASE_URL=
OPENAI_TEAM_ORGANIZATION=
OPENAI_TEAM_PROJECT=
BOS_CODE_OPENAI_REASONING_EFFORT=medium

# BOS Media / Remotion runtime
# Uses the isolated frontend/remotion-runtime workspace instead of the main frontend dependency tree.
BOS_MEDIA_REMOTION_ENABLED=true
BOS_MEDIA_REMOTION_RUNTIME_DIR=frontend/remotion-runtime
BOS_MEDIA_REMOTION_OUTPUT_DIR=backend/generated/remotion
BOS_MEDIA_REMOTION_NODE_EXECUTABLE=node
BOS_MEDIA_REMOTION_ENABLE_LLM_SUGGESTIONS=true
BOS_MEDIA_REMOTION_SUGGEST_MODEL=gpt-5.5

# WeChat official account channel
WECHAT_ENABLE_OFFICIAL_ACCOUNTS=true
WECHAT_REPLY_TIMEOUT_SECONDS=8
WECHAT_DEFAULT_WELCOME_MESSAGE=你好，这里是 BOS 助手。你可以直接发送文本消息开始对话。
WECHAT_DEFAULT_UNSUPPORTED_MESSAGE=当前仅支持文本消息。请直接发送文字内容。
WECHAT_DEFAULT_ERROR_MESSAGE=消息已收到，但处理时出现问题，请稍后再试。
WECHAT_DEFAULT_EMPTY_MESSAGE=我收到了空消息，请发送文字内容。
WECHAT_DEFAULT_PROMPT_PREFIX=你现在通过微信官方号与用户对话。请默认使用简体中文回复，语气自然、直接、友好。优先给出明确可执行答案，不要空泛寒暄。除非用户要求，否则回复尽量简洁。
WECHAT_WEB_BASE_URL=

# Final Action external share delivery
BOS_EXTERNAL_SHARE_ALLOWED_ENDPOINTS=http://127.0.0.1,http://localhost
BOS_EXTERNAL_SHARE_TIMEOUT_SECONDS=10

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws
